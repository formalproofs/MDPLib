/-- similar to `exists_probability_leq_eq_probability_lt_of_lt_max` but no precondition -/
theorem exists_probability_leq_eq_probability_lt : ∃q > t,  ℙ[X ≤ᵣ t // P] = ℙ[X <ᵣ q // P] :=
      let ⟨q, hq⟩ := exists_leq_eq_lt X t P
