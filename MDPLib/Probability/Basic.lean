    ∃q > t, ℙ[X ≤ᵣ t // P] = ℙ[X <ᵣ q // P] ∧ q ∈ (Finset.univ.image X) := sorry
          --let ⟨q, hq⟩ := exists_leq_eq_lt_of_lt_max P t h
