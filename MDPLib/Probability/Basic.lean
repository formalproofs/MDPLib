section RandomVariables
namespace FinRV
open Findist

variable {Ω : Type} [Nonempty Ω] {X Y : FinRV Ω R} {t t₁ t₂ : R}

theorem indicator_leq_mono (h1 : X ≤ Y) (h2: t₁ ≤ t₂) : (𝕀 ∘ (Y ≤ᵣ t₁) : FinRV Ω R) ≤ 𝕀 ∘ (X ≤ᵣ t₂) := by 
    intro ω   
    by_cases h3 : Y ω ≤ t₁
    · simp [FinRV.leq, 𝕀, indicator, h3, (le_trans (le_trans (h1 ω) h3) h2)] 
    · by_cases h5 : X ω ≤ t₂
      repeat simp [h3, h5, 𝕀, indicator] 

theorem indicator_lt_mono (h1 : X ≤ Y) (h2: t₁ ≤ t₂) : (𝕀 ∘ (Y <ᵣ t₁) : FinRV Ω R) ≤ 𝕀 ∘ (X <ᵣ t₂) := by 
    intro ω   
    by_cases h3 : Y ω < t₁
    · have h4 : X ω < t₂ := 
        calc X ω ≤ Y ω := h1 ω
             _ < t₁ := h3
             _ ≤ t₂ := h2 
      simp [FinRV.lt, 𝕀, indicator, h3, h4] 
    · by_cases h5 : X ω < t₂
      repeat simp [h3, h5, 𝕀, indicator] 

theorem gt_of_geq_of_lt {t₁ t₂ : R} (h : t₁ < t₂) (ω) (hω : (X ≥ᵣ t₂) ω ) : (X >ᵣ t₁) ω :=
    by simp [FinRV.gt, FinRV.geq] at hω ⊢
       order

variable [FinEnum Ω] {P : Findist R Ω} {A B : FinRV Ω Bool}

theorem leq_max : (X ≤ᵣ (FinRV.max X)) = 1 :=
    by ext ω; simpa using le_max ω

theorem max_mem_image : (FinRV.max X) ∈ Finset.univ.image X :=
     Finset.max'_mem (Finset.image X Finset.univ) (image_univ_nonempty X)

theorem min_le (ω) : (FinRV.min X) ≤ X ω :=
   Finset.min'_le (Finset.image X Finset.univ) (X ω) (Finset.mem_image_of_mem X (Finset.mem_univ ω))

theorem geq_min : (X ≥ᵣ (FinRV.min X)) = 1 :=
    by ext ω; simpa using min_le ω

-- results for discrete probability distributions
section Atomic 

variable (P : Findist R Ω) (X : FinRV Ω R) (t : R)

theorem _root_.Findist.exists_eq_of_probability_pos {b : R} (h : ℙ[X =ᵣ b // P] > 0) : ∃ω, X ω = b := by 
    obtain ⟨ω, hω⟩ : ∃ω, (𝕀 ∘ (X=ᵣb)) ω > 0 := exists_pos_of_dotProduct_pos (P.nonneg) h 
    use ω
    by_contra!
    simp_all [𝕀, indicator]


/-! Computes the smallest successive potential atom for `t`. It is a potential atom because
    it may have probability zero.
    see also: Finset.exists_next_right -/
@[to_dual] -- autogenerated name: predQuark
def succQuark (t : R) (h : t < (FinRV.max X)) : R := 
     let 𝓧 := Finset.univ.image X
     let 𝓨 := 𝓧.filter (fun x ↦ x > t)
     let h_nonempty : 𝓨.Nonempty := Finset.filter_nonempty_iff.mpr ⟨FinRV.max X, ⟨max_mem_image, h⟩⟩
     𝓨.min' h_nonempty

@[to_dual predQuark_lt]
theorem succQuark_gt {t : R} (h : t < (FinRV.max  X)) : t < (succQuark X t h) := by
    unfold succQuark; extract_lets 𝓧 𝓨 h_nonempty
    exact (Finset.mem_filter.mp (Finset.min'_mem 𝓨 h_nonempty)).right 

@[to_dual predQuark_in_image]
theorem succQuark_in_image {t : R} (h : t < (FinRV.max  X)) : (succQuark X t h) ∈ (Finset.univ.image X) := sorry

theorem exists_leq_eq_lt_of_lt_max (h0 : t < (FinRV.max  X)) : ∃q > t, (X ≤ᵣ t) = (X <ᵣ q) ∧ q ∈ (Finset.univ.image X) := by
     let 𝓧 := Finset.univ.image X
     let 𝓨 := 𝓧.filter (fun x ↦ x > t)
     have hnonempty : 𝓨.Nonempty := Finset.filter_nonempty_iff.mpr ⟨FinRV.max X, ⟨max_mem_image, h0⟩⟩
     let q := 𝓨.min' hnonempty
     have q_ge_t : q > t := (Finset.mem_filter.mp (Finset.min'_mem 𝓨 hnonempty)).right 
     use q
     constructor
     · exact q_ge_t
     · constructor
       · ext ω
         rw [FinRV.leq,FinRV.lt,decide_eq_decide]
         constructor
         · exact fun h2 => lt_of_le_of_lt h2 q_ge_t
         · intro h2
           have hxω : X ω ∉ 𝓨 := by
              by_contra! inY; exact not_lt_of_ge (Finset.min'_le 𝓨 (X ω) inY) h2
           rw [Finset.mem_filter] at hxω
           push Not at hxω
           exact hxω (Finset.mem_image_of_mem X (Finset.mem_univ ω))
       · exact Finset.mem_of_mem_filter q (Finset.min'_mem 𝓨 hnonempty)

theorem exists_leq_eq_lt (P : Findist R Ω) : ∃q > t,  (X ≤ᵣ t) = (X <ᵣ q) :=
       by cases' lt_or_ge t (FinRV.max X) with hlt hge
          · obtain ⟨q, h⟩ := exists_leq_eq_lt_of_lt_max  X t hlt
            exact ⟨q, ⟨h.1, h.2.1⟩⟩
          · have h := le_max (X:=X)
            grw [hge] at h
            let q := t + 1
            have b : ∀ω, X ω < q := fun ω => lt_add_of_le_of_pos (h ω) zero_lt_one
            have ab : (X ≤ᵣ t) = (X <ᵣ q) := by ext ω; simp_all [FinRV.leq, FinRV.lt]
            exact ⟨q, ⟨lt_add_one t, ab⟩⟩

theorem exists_geq_eq_gt_of_min_lt (h0 : t > (FinRV.min X)) : ∃q < t, (X ≥ᵣ t) = (X >ᵣ q) ∧ q ∈ (Finset.univ.image X) := by sorry

end Atomic

